{
  "name": "devhub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "sync:appkit-docs": "node scripts/sync-appkit-docs.mjs --force",
    "docs:cli-sync": "tsx scripts/gen-cli-options.ts",
    "docs:skills-sync": "tsx scripts/gen-aitools-skills.ts",
    "docs:sync": "pnpm docs:cli-sync && pnpm docs:skills-sync",
    "typecheck": "tsc",
    "fmt": "pnpm exec prettier -w .",
    "test": "pnpm build && vitest run && pnpm exec playwright test",
    "test:smoke": "vitest run",
    "test:e2e": "pnpm exec playwright test",
    "test:critical": "pnpm build && pnpm exec playwright test --config playwright.critical.config.ts",
    "test:docs-verify": "vitest run --config vitest.docs-verify.config.ts",
    "verify:images": "node scripts/verify-resource-images.mjs",
    "optimize:images": "bash scripts/optimize-images.sh",
    "build:hero-player": "node scripts/build-home-hero-player.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "prepare": "husky",
    "prebuild": "node scripts/build-home-hero-player.mjs && node scripts/sync-appkit-docs.mjs",
    "predev": "node scripts/build-home-hero-player.mjs && node scripts/sync-appkit-docs.mjs",
    "prestart": "node scripts/build-home-hero-player.mjs && node scripts/sync-appkit-docs.mjs",
    "postbuild": "node scripts/generate-next-static-artifacts.mjs && next-sitemap --config next-sitemap.config.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@databricks/appkit-ui": "^0.22.0",
    "@mdx-js/loader": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@next/mdx": "^16.2.10",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "lz-string": "^1.5.0",
    "mcp-handler": "^1.0.7",
    "mermaid": "11.15.0",
    "motion": "^12.39.0",
    "next": "16.2.10",
    "next-sitemap": "^4.2.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4",
    "recharts": "2.15.4",
    "remark": "^15.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "shiki": "3.19.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@playwright/test": "^1.58.2",
    "@shikijs/rehype": "^3.19.0",
    "@shikijs/transformers": "^3.19.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mdast": "^4.0.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.27.0",
    "fallow": "^2.45.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "mdast-util-mdx-jsx": "^3.2.0",
    "npm-to-yarn": "^3.0.1",
    "postcss": "^8.5.8",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "unist-util-visit": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.11.0"
}
